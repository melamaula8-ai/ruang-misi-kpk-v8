# Frontend build uses the Google Client ID through the server config endpoint.
# Google OAuth Client ID (produksi: dibaca dari [vars] di wrangler.toml; lokal: .dev.vars)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# Optional environment-based teacher admin login. Prefer registered Google teacher accounts.
TEACHER_USERNAME="guru-admin"
# Generate with: npm run hash:password
TEACHER_PASSWORD_HASH="pbkdf2-sha256$210000$REPLACE_SALT$REPLACE_HASH"
# Use a random secret of at least 32 characters. Keep it private.
TEACHER_SESSION_SECRET="replace-with-random-secret-at-least-32-characters"
